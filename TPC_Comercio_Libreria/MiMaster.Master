<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="MiMaster.master.cs" Inherits="TPC_Comercio_Libreria.MiMaster" %>

<!DOCTYPE html>
<html>
<head runat="server">
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <title></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
    <asp:ContentPlaceHolder ID="head" runat="server"></asp:ContentPlaceHolder>
    <link rel="stylesheet" href="Content/Styles.css" />
</head>
<body>
    <form id="form1" runat="server">

        <nav class="navbar navbar-light" style="background-color: #D2B48C;">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold mb-0" href="Inicio.aspx">Librería Escolar</a>

                <asp:Button ID="btnCerrarSesion" runat="server"
                            Text="Cerrar sesión"
                            CssClass="btn btn-outline-dark btn-sm"
                            OnClick="btnCerrarSesion_Click" />
            </div>
        </nav>

        <div class="container py-4">
            <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server"></asp:ContentPlaceHolder>
        </div>

    </form>
</body>
</html>